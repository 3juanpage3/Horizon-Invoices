# MongoDB Atlas connection string (same cluster, any database)
# Option 1 — put your database name in the URL (recommended):
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/your_database_name?retryWrites=true&w=majority
#
# Option 2 — set the database name separately:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# DATABASE_NAME=your_database_name

DATABASE_URL=
DATABASE_NAME=
